# Generate each secret independently with: openssl rand -hex 32
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
BOOTSTRAP_TOKEN=
API_KEY_PEPPER=
# A Cloudflare API token scoped to Account / D1 / Edit for this account only.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_TOKEN=
# Comma-separated exact browser origins. Empty means no cross-origin access.
CORS_ORIGINS=
